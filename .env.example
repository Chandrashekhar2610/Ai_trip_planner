# Environment Variables for AI Trip Planner
# Copy this file to .env and fill in your keys if you want to use cloud LLM APIs.
# Note: The app also runs 100% offline with its built-in expert travel engine!

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=

# Application Port
PORT=5001

# Flask Secret Key
SECRET_KEY=wanderai-travel-secret-key-change-me

